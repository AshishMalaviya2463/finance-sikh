<form id="contact-form" class="card grid gap-4" novalidate><label>Name<input class="mt-1 block w-full rounded border p-2" name="name" maxlength="100" required /></label><label>Email<input class="mt-1 block w-full rounded border p-2" name="email" type="email" maxlength="254" required /></label><label>Subject <span class="text-sm text-slate-600">(optional)</span><input class="mt-1 block w-full rounded border p-2" name="subject" maxlength="160" /></label><label>Message<textarea class="mt-1 block w-full rounded border p-2" name="message" rows="6" maxlength="5000" required></textarea></label><label class="sr-only">Leave this field empty<input name="website" tabindex="-1" autocomplete="off" /></label><label class="flex gap-2"><input name="privacy" type="checkbox" required /> <span>I have read the <a href="/privacy-policy/">Privacy Policy</a>.</span></label><button class="button w-fit" type="submit">Send message</button><p id="contact-status" role="status" aria-live="polite"></p></form>
<script>
import { addDoc, collection, serverTimestamp } from 'firebase/firestore'; import { db, firebaseReady } from '../lib/firebase/client';
const form = document.querySelector<HTMLFormElement>('#contact-form'); const status = document.querySelector<HTMLElement>('#contact-status');
if (form && status) form.addEventListener('submit', async (event) => { event.preventDefault(); const data = new FormData(form); const submit = form.querySelector<HTMLButtonElement>('button'); if (!submit) return; const fields = ['name','email','subject','message']; const values = Object.fromEntries(fields.map(key => [key, String(data.get(key) ?? '').trim()])); if (!values.name || !/^\S+@\S+\.\S+$/.test(values.email) || !values.message || !data.get('privacy')) { status.textContent = 'Please complete the required fields with a valid email address.'; return; } if (data.get('website')) { status.textContent = 'Unable to submit this message.'; return; } if (!firebaseReady || !db) { status.textContent = 'Contact form setup is incomplete. Please use [OWNER: real email].'; return; } submit.disabled = true; status.textContent = 'Sending…'; try { await addDoc(collection(db, 'contactMessages'), { ...values, createdAt: serverTimestamp() }); form.reset(); status.textContent = 'Thanks—your message was submitted. Messages are not automatically emailed.'; } catch { status.textContent = 'Your message could not be sent. Please try again later or use [OWNER: real email].'; } finally { submit.disabled = false; } });
</script>

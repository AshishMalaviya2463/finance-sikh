<form id="contact-form" class="card grid gap-5" novalidate><div><h2 class="text-2xl font-bold">Send a message</h2><p class="mt-1 text-sm text-slate-600">Fields marked required are needed to respond to a site enquiry.</p></div><label class="font-semibold">Name <span aria-hidden="true">*</span><input class="mt-1 block w-full rounded-lg border border-slate-300 p-3 font-normal" name="name" maxlength="100" autocomplete="name" required /></label><label class="font-semibold">Email <span aria-hidden="true">*</span><input class="mt-1 block w-full rounded-lg border border-slate-300 p-3 font-normal" name="email" type="email" maxlength="254" autocomplete="email" required /></label><label class="font-semibold">Subject <span class="text-sm font-normal text-slate-600">(optional)</span><input class="mt-1 block w-full rounded-lg border border-slate-300 p-3 font-normal" name="subject" maxlength="160" /></label><label class="font-semibold">Message <span aria-hidden="true">*</span><textarea class="mt-1 block w-full rounded-lg border border-slate-300 p-3 font-normal" name="message" rows="7" maxlength="5000" required></textarea></label><label class="sr-only">Leave this field empty<input name="website" tabindex="-1" autocomplete="off" /></label><label class="flex items-start gap-2 text-sm"><input class="mt-1" name="privacy" type="checkbox" required /> <span>I have read the <a href="/privacy-policy/">Privacy Policy</a> and agree that my message may be stored to handle this enquiry.</span></label><button class="button w-fit" type="submit">Send message</button><p id="contact-status" class="min-h-6 text-sm" role="status" aria-live="polite"></p></form>
<script>
import { addDoc, collection, serverTimestamp } from 'firebase/firestore'; import { db, firebaseReady } from '../lib/firebase/client';
const form = document.querySelector<HTMLFormElement>('#contact-form'); const status = document.querySelector<HTMLElement>('#contact-status');
if (form && status) form.addEventListener('submit', async (event) => { event.preventDefault(); const data = new FormData(form); const submit = form.querySelector<HTMLButtonElement>('button'); if (!submit) return; const fields = ['name','email','subject','message']; const values = Object.fromEntries(fields.map(key => [key, String(data.get(key) ?? '').trim()])); if (!values.name || !/^\S+@\S+\.\S+$/.test(values.email) || !values.message || !data.get('privacy')) { status.textContent = 'Please complete the required fields with a valid email address.'; return; } if (data.get('website')) { status.textContent = 'Unable to submit this message.'; return; } if (!firebaseReady || !db) { status.textContent = 'Contact form setup is incomplete. Please use financesikh.learn@gmail.com.'; return; } submit.disabled = true; status.textContent = 'Sending…'; try { await addDoc(collection(db, 'contactMessages'), { ...values, createdAt: serverTimestamp() }); form.reset(); status.textContent = 'Thanks—your message was submitted. Messages are not automatically emailed.'; } catch { status.textContent = 'Your message could not be sent. Please try again later or use financesikh.learn@gmail.com.'; } finally { submit.disabled = false; } });
</script>

<form class="card grid gap-4" id="swp-calculator" novalidate><h2 class="text-2xl font-bold">SWP calculator</h2><label>Initial corpus (₹)<input class="mt-1 block w-full rounded border p-2" name="initialCorpus" type="number" min="1" value="1000000" required /></label><label>Monthly withdrawal (₹)<input class="mt-1 block w-full rounded border p-2" name="monthlyWithdrawal" type="number" min="1" value="10000" required /></label><label>Expected annual return (%)<input class="mt-1 block w-full rounded border p-2" name="annualRate" type="number" min="0" step="0.01" value="6" required /></label><label>Withdrawal duration (years)<input class="mt-1 block w-full rounded border p-2" name="years" type="number" min="0.1" step="0.1" value="5" required /></label><button class="button w-fit" type="submit">Calculate estimate</button><p id="swp-error" class="text-red-700" role="alert"></p><div id="swp-result" aria-live="polite" class="rounded-lg bg-slate-50 p-4">Enter assumptions to see an illustrative estimate.</div><p class="text-sm text-slate-600">Each month, the corpus earns the assumed return before the withdrawal. Tax, fees, inflation and market volatility are excluded.</p></form>
<script>
import { calculateSwp } from '../../lib/finance/swp'; import { formatINR } from '../../lib/finance/formatters';
const form = document.querySelector<HTMLFormElement>('#swp-calculator'); const output = document.querySelector<HTMLElement>('#swp-result'); const error = document.querySelector<HTMLElement>('#swp-error');
if (form && output && error) form.addEventListener('submit', (event) => { event.preventDefault(); const data = new FormData(form); try { const result = calculateSwp({ initialCorpus: Number(data.get('initialCorpus')), monthlyWithdrawal: Number(data.get('monthlyWithdrawal')), annualRate: Number(data.get('annualRate')), years: Number(data.get('years')) }); error.textContent = ''; output.innerHTML = `<strong>Illustrative results</strong><dl><dt>Total actually withdrawn</dt><dd>${formatINR(result.totalWithdrawn)}</dd><dt>Estimated remaining corpus</dt><dd>${formatINR(result.remainingCorpus)}</dd>${result.depletedMonth ? `<dt>Corpus depleted</dt><dd>Month ${result.depletedMonth}</dd>` : ''}</dl>`; } catch (issue) { error.textContent = issue instanceof Error ? issue.message : 'Check the values entered.'; output.textContent = ''; } });
</script>

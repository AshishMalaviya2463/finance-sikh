<form class="card grid gap-6" id="swp-calculator" novalidate>
  <div><p class="font-semibold text-teal">Withdrawal planner</p><h2 class="mt-1 text-2xl font-bold">SWP calculator</h2></div>
  <fieldset class="grid gap-5"><legend class="sr-only">SWP assumptions</legend>
    <label class="grid gap-2 font-semibold">Initial corpus (₹)<div class="grid gap-3 sm:grid-cols-[1fr_12rem] sm:items-center"><input class="w-full accent-teal" data-slider="initialCorpus" type="range" min="1000000" max="1000000000" step="1000000" value="1000000" aria-label="Initial corpus slider" /><input class="w-full rounded-lg border border-slate-300 p-3 font-normal" data-number="initialCorpus" name="initialCorpus" type="number" min="1000000" max="1000000000" step="1000000" value="1000000" inputmode="numeric" required /></div><span class="text-xs font-normal text-slate-600">₹10,00,000 to ₹1,00,00,00,000</span></label>
    <label class="grid gap-2 font-semibold">Monthly withdrawal (₹)<div class="grid gap-3 sm:grid-cols-[1fr_12rem] sm:items-center"><input class="w-full accent-teal" data-slider="monthlyWithdrawal" type="range" min="5000" max="100000000" step="5000" value="10000" aria-label="Monthly withdrawal slider" /><input class="w-full rounded-lg border border-slate-300 p-3 font-normal" data-number="monthlyWithdrawal" name="monthlyWithdrawal" type="number" min="5000" max="100000000" step="5000" value="10000" inputmode="numeric" required /></div><span class="text-xs font-normal text-slate-600">₹5,000 to ₹10,00,00,000 per month</span></label>
    <label class="grid gap-2 font-semibold">Expected annual return (%)<div class="grid gap-3 sm:grid-cols-[1fr_12rem] sm:items-center"><input class="w-full accent-teal" data-slider="annualRate" type="range" min="0" max="100" step="0.1" value="6" aria-label="Expected annual return slider" /><input class="w-full rounded-lg border border-slate-300 p-3 font-normal" data-number="annualRate" name="annualRate" type="number" min="0" max="100" step="0.1" value="6" inputmode="decimal" required /></div><span class="text-xs font-normal text-slate-600">0% to 100% annually</span></label>
    <label class="grid gap-2 font-semibold">Withdrawal duration (years)<div class="grid gap-3 sm:grid-cols-[1fr_12rem] sm:items-center"><input class="w-full accent-teal" data-slider="years" type="range" min="1" max="100" step="1" value="5" aria-label="Withdrawal duration slider" /><input class="w-full rounded-lg border border-slate-300 p-3 font-normal" data-number="years" name="years" type="number" min="1" max="100" step="1" value="5" inputmode="numeric" required /></div><span class="text-xs font-normal text-slate-600">1 to 100 years</span></label>
  </fieldset>
  <p id="swp-error" class="min-h-5 text-sm text-red-700" role="alert"></p>
  <section id="swp-result" aria-live="polite" class="rounded-xl bg-slate-50 p-5"></section>
  <p class="text-sm leading-6 text-slate-600">Estimates update shortly after you change an input. Each month, the corpus earns the assumed return before the withdrawal; tax, fees, inflation and market volatility are excluded.</p>
</form>
<script>
import { calculateSwp } from '../../lib/finance/swp';
import { formatINR } from '../../lib/finance/formatters';
const form = document.querySelector<HTMLFormElement>('#swp-calculator')!;
const output = document.querySelector<HTMLElement>('#swp-result')!;
const error = document.querySelector<HTMLElement>('#swp-error')!;
function donutChart(primary: number, secondary: number, primaryLabel: string, secondaryLabel: string, title: string) { const total=Math.max(primary+secondary,1); const circumference=339.292; const primaryLength=(primary/total)*circumference; const secondaryLength=(secondary/total)*circumference; const primaryPercent=Math.round((primary/total)*100); const secondaryPercent=100-primaryPercent; return `<figure class="mt-6 grid items-center gap-4 sm:grid-cols-[12rem_1fr]"><svg class="mx-auto size-48" viewBox="0 0 200 200" role="img" aria-label="${title}"><circle cx="100" cy="100" r="54" fill="none" stroke="#d9e0e5" stroke-width="30"/><circle cx="100" cy="100" r="54" fill="none" stroke="#087c78" stroke-width="30" stroke-dasharray="${primaryLength} ${circumference-primaryLength}" stroke-linecap="butt" transform="rotate(-90 100 100)"/><circle cx="100" cy="100" r="54" fill="none" stroke="#1e6f9f" stroke-width="30" stroke-dasharray="${secondaryLength} ${circumference-secondaryLength}" stroke-dashoffset="-${primaryLength}" stroke-linecap="butt" transform="rotate(-90 100 100)"/><text x="100" y="94" text-anchor="middle" class="fill-ink text-[18px] font-bold">${primaryPercent}%</text><text x="100" y="116" text-anchor="middle" class="fill-slate-600 text-[11px]">${primaryLabel}</text></svg><figcaption><p class="font-semibold">Illustrative breakdown</p><ul class="mt-3 space-y-2 text-sm"><li class="flex items-center gap-2"><span class="size-3 rounded-full bg-teal"></span>${primaryLabel}: ${formatINR(primary)} (${primaryPercent}%)</li><li class="flex items-center gap-2"><span class="size-3 rounded-full bg-[#1e6f9f]"></span>${secondaryLabel}: ${formatINR(secondary)} (${secondaryPercent}%)</li></ul></figcaption></figure>`; }
if (form && output && error) {
  let debounceTimer: ReturnType<typeof setTimeout> | undefined;
  function syncControl(field: string, source: HTMLInputElement) { const slider=form.querySelector<HTMLInputElement>(`[data-slider="${field}"]`); const number=form.querySelector<HTMLInputElement>(`[data-number="${field}"]`); if (!slider || !number) return; const value=Number(source.value); if (Number.isFinite(value) && value>=Number(slider.min) && value<=Number(slider.max)) { slider.value=String(value); number.value=String(value); } }
  function render() { const data=new FormData(form); try { const result=calculateSwp({ initialCorpus:Number(data.get('initialCorpus')), monthlyWithdrawal:Number(data.get('monthlyWithdrawal')), annualRate:Number(data.get('annualRate')), years:Number(data.get('years')) }); error.textContent=''; const depletion=result.depletedMonth ? `<div class="min-w-0"><dt class="text-sm text-slate-600">Corpus depleted</dt><dd class="mt-1 text-base font-bold text-red-700 sm:text-xl">Month ${result.depletedMonth}</dd></div>` : `<div class="min-w-0"><dt class="text-sm text-slate-600">Estimated remaining corpus</dt><dd class="mt-1 break-all text-base font-bold text-teal sm:text-xl">${formatINR(result.remainingCorpus)}</dd></div>`; output.innerHTML=`<div class="grid gap-4 sm:grid-cols-3"><div class="min-w-0"><dt class="text-sm text-slate-600">Initial corpus</dt><dd class="mt-1 break-all text-base font-bold sm:text-xl">${formatINR(Number(data.get('initialCorpus')))}</dd></div><div class="min-w-0"><dt class="text-sm text-slate-600">Total actually withdrawn</dt><dd class="mt-1 break-all text-base font-bold sm:text-xl">${formatINR(result.totalWithdrawn)}</dd></div>${depletion}</div>${donutChart(result.totalWithdrawn,result.remainingCorpus,'Total withdrawn','Remaining corpus','Donut chart showing total withdrawn and remaining corpus')}`; } catch (issue) { error.textContent=issue instanceof Error ? issue.message : 'Check the values entered.'; output.innerHTML=''; } }
  function scheduleRender() { clearTimeout(debounceTimer); debounceTimer=setTimeout(render,180); }
  form.querySelectorAll<HTMLInputElement>('[data-slider], [data-number]').forEach((control)=>control.addEventListener('input',()=>{ syncControl(control.dataset.slider ?? control.dataset.number ?? '',control); scheduleRender(); }));
  form.querySelectorAll<HTMLInputElement>('input[type="number"]').forEach((control)=>control.addEventListener('input',scheduleRender));
  form.addEventListener('submit',(event)=>event.preventDefault());
  render();
}
</script>

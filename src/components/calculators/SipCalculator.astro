<form class="card grid gap-4" id="sip-calculator" novalidate><h2 class="text-2xl font-bold">SIP calculator</h2><label>Monthly investment (₹)<input class="mt-1 block w-full rounded border p-2" name="monthlyInvestment" type="number" min="1" value="5000" required /></label><label>Expected annual return (%)<input class="mt-1 block w-full rounded border p-2" name="annualRate" type="number" min="0" step="0.01" value="10" required /></label><label>Investment duration (years)<input class="mt-1 block w-full rounded border p-2" name="years" type="number" min="0.1" step="0.1" value="10" required /></label><button class="button w-fit" type="submit">Calculate estimate</button><p id="sip-error" class="text-red-700" role="alert"></p><div id="sip-result" aria-live="polite" class="rounded-lg bg-slate-50 p-4">Enter assumptions to see an illustrative estimate.</div><p class="text-sm text-slate-600">Contributions are assumed at each month end. Returns are variable and this is not a forecast.</p></form>
<script>
import { calculateSip } from '../../lib/finance/sip'; import { formatINR } from '../../lib/finance/formatters';
const form = document.querySelector<HTMLFormElement>('#sip-calculator'); const output = document.querySelector<HTMLElement>('#sip-result'); const error = document.querySelector<HTMLElement>('#sip-error');
if (form && output && error) form.addEventListener('submit', (event) => { event.preventDefault(); const data = new FormData(form); try { const result = calculateSip({ monthlyInvestment: Number(data.get('monthlyInvestment')), annualRate: Number(data.get('annualRate')), years: Number(data.get('years')) }); error.textContent = ''; output.innerHTML = `<strong>Illustrative results</strong><dl><dt>Total invested</dt><dd>${formatINR(result.invested)}</dd><dt>Estimated future value</dt><dd>${formatINR(result.futureValue)}</dd><dt>Estimated gain</dt><dd>${formatINR(result.gain)}</dd></dl>`; } catch (issue) { error.textContent = issue instanceof Error ? issue.message : 'Check the values entered.'; output.textContent = ''; } });
</script>

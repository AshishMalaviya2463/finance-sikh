<form class="card grid gap-6" id="sip-calculator" novalidate>
  <div><p class="font-semibold text-teal">Monthly investment planner</p><h2 class="mt-1 text-2xl font-bold">SIP calculator</h2></div>
  <fieldset class="grid gap-5"><legend class="sr-only">SIP assumptions</legend>
    <label class="grid gap-2 font-semibold">Monthly investment (₹)<div class="grid gap-3 sm:grid-cols-[1fr_11rem] sm:items-center"><input class="w-full accent-teal" data-slider="monthlyInvestment" type="range" min="500" max="500000" step="500" value="5000" aria-label="Monthly investment slider" /><input class="w-full rounded-lg border border-slate-300 p-3 font-normal" data-number="monthlyInvestment" name="monthlyInvestment" type="number" min="500" max="500000" step="500" value="5000" inputmode="numeric" required /></div><span class="text-xs font-normal text-slate-600">₹500 to ₹5,00,000 per month</span></label>
    <label class="grid gap-2 font-semibold">Expected annual return (%)<div class="grid gap-3 sm:grid-cols-[1fr_11rem] sm:items-center"><input class="w-full accent-teal" data-slider="annualRate" type="range" min="0" max="100" step="0.1" value="10" aria-label="Expected annual return slider" /><input class="w-full rounded-lg border border-slate-300 p-3 font-normal" data-number="annualRate" name="annualRate" type="number" min="0" max="100" step="0.1" value="10" inputmode="decimal" required /></div><span class="text-xs font-normal text-slate-600">0% to 100% annually</span></label>
    <label class="grid gap-2 font-semibold">Investment duration (years)<div class="grid gap-3 sm:grid-cols-[1fr_11rem] sm:items-center"><input class="w-full accent-teal" data-slider="years" type="range" min="1" max="100" step="1" value="10" aria-label="Investment duration slider" /><input class="w-full rounded-lg border border-slate-300 p-3 font-normal" data-number="years" name="years" type="number" min="1" max="100" step="1" value="10" inputmode="numeric" required /></div><span class="text-xs font-normal text-slate-600">1 to 100 years</span></label>
    <label class="flex items-start gap-3 rounded-lg border border-[var(--color-line)] bg-slate-50 p-4 text-sm font-semibold"><input class="mt-1 size-4 accent-teal" name="stepUpEnabled" type="checkbox" /> <span>Increase my monthly SIP every year</span></label>
    <label class="hidden grid gap-2 font-semibold" data-step-up-field>Annual SIP step-up (%)<div class="grid gap-3 sm:grid-cols-[1fr_11rem] sm:items-center"><input class="w-full accent-teal" data-slider="annualStepUpPercent" type="range" min="0" max="100" step="0.5" value="10" aria-label="Annual SIP step-up slider" /><input class="w-full rounded-lg border border-slate-300 p-3 font-normal" data-number="annualStepUpPercent" name="annualStepUpPercent" type="number" min="0" max="100" step="0.5" value="10" inputmode="decimal" /></div><span class="text-xs font-normal text-slate-600">Your monthly contribution increases after each 12 months.</span></label>
  </fieldset>
  <p id="sip-error" class="min-h-5 text-sm text-red-700" role="alert"></p>
  <section id="sip-result" aria-live="polite" class="rounded-xl bg-slate-50 p-5"></section>
  <p class="text-sm leading-6 text-slate-600">Estimates update shortly after you change an input. Contributions are assumed at month end; returns are variable and not guaranteed.</p>
</form>
<script>
import { calculateSip } from '../../lib/finance/sip';
import { formatINR } from '../../lib/finance/formatters';
const form = document.querySelector<HTMLFormElement>('#sip-calculator')!;
const output = document.querySelector<HTMLElement>('#sip-result')!;
const error = document.querySelector<HTMLElement>('#sip-error')!;
function donutChart(primary: number, secondary: number, primaryLabel: string, secondaryLabel: string, title: string) { const total=Math.max(primary+secondary,1); const circumference=339.292; const primaryLength=(primary/total)*circumference; const secondaryLength=(secondary/total)*circumference; const primaryPercent=Math.round((primary/total)*100); const secondaryPercent=100-primaryPercent; return `<figure class="mt-6 grid items-center gap-4 sm:grid-cols-[12rem_1fr]"><svg class="mx-auto size-48" viewBox="0 0 200 200" role="img" aria-label="${title}"><circle cx="100" cy="100" r="54" fill="none" stroke="#d9e0e5" stroke-width="30"/><circle cx="100" cy="100" r="54" fill="none" stroke="#087c78" stroke-width="30" stroke-dasharray="${primaryLength} ${circumference-primaryLength}" stroke-linecap="butt" transform="rotate(-90 100 100)"/><circle cx="100" cy="100" r="54" fill="none" stroke="#1e6f9f" stroke-width="30" stroke-dasharray="${secondaryLength} ${circumference-secondaryLength}" stroke-dashoffset="-${primaryLength}" stroke-linecap="butt" transform="rotate(-90 100 100)"/><text x="100" y="94" text-anchor="middle" class="fill-ink text-[18px] font-bold">${primaryPercent}%</text><text x="100" y="116" text-anchor="middle" class="fill-slate-600 text-[11px]">${primaryLabel}</text></svg><figcaption><p class="font-semibold">Illustrative breakdown</p><ul class="mt-3 space-y-2 text-sm"><li class="flex items-center gap-2"><span class="size-3 rounded-full bg-teal"></span>${primaryLabel}: ${formatINR(primary)} (${primaryPercent}%)</li><li class="flex items-center gap-2"><span class="size-3 rounded-full bg-[#1e6f9f]"></span>${secondaryLabel}: ${formatINR(secondary)} (${secondaryPercent}%)</li></ul></figcaption></figure>`; }
if (form && output && error) {
  const stepUpToggle = form.elements.namedItem('stepUpEnabled') as HTMLInputElement;
  const stepUpField = form.querySelector<HTMLElement>('[data-step-up-field]');
  let debounceTimer: ReturnType<typeof setTimeout> | undefined;
  function syncControl(field: string, source: HTMLInputElement) { const slider=form.querySelector<HTMLInputElement>(`[data-slider="${field}"]`); const number=form.querySelector<HTMLInputElement>(`[data-number="${field}"]`); if (!slider || !number) return; const value=Number(source.value); if (Number.isFinite(value) && value>=Number(slider.min) && value<=Number(slider.max)) { slider.value=String(value); number.value=String(value); } }
  function render() { const data=new FormData(form); try { const result=calculateSip({ monthlyInvestment:Number(data.get('monthlyInvestment')), annualRate:Number(data.get('annualRate')), years:Number(data.get('years')), annualStepUpPercent:stepUpToggle.checked ? Number(data.get('annualStepUpPercent')) : 0 }); error.textContent=''; output.innerHTML=`<div class="grid gap-4 sm:grid-cols-3"><div class="min-w-0"><dt class="text-sm text-slate-600">Total invested</dt><dd class="mt-1 break-all text-base font-bold sm:text-xl">${formatINR(result.invested)}</dd></div><div class="min-w-0"><dt class="text-sm text-slate-600">Estimated future value</dt><dd class="mt-1 break-all text-base font-bold text-teal sm:text-xl">${formatINR(result.futureValue)}</dd></div><div class="min-w-0"><dt class="text-sm text-slate-600">Estimated gain</dt><dd class="mt-1 break-all text-base font-bold sm:text-xl">${formatINR(result.gain)}</dd></div></div>${donutChart(result.invested,result.gain,'Invested amount','Estimated gain','Donut chart showing invested amount and estimated gain')}`; } catch (issue) { error.textContent=issue instanceof Error ? issue.message : 'Check the values entered.'; output.innerHTML=''; } }
  function scheduleRender() { clearTimeout(debounceTimer); debounceTimer=setTimeout(render,180); }
  form.querySelectorAll<HTMLInputElement>('[data-slider], [data-number]').forEach((control)=>control.addEventListener('input',()=>{ syncControl(control.dataset.slider ?? control.dataset.number ?? '',control); scheduleRender(); }));
  form.querySelectorAll<HTMLInputElement>('input[type="number"]').forEach((control)=>control.addEventListener('input',scheduleRender));
  stepUpToggle.addEventListener('change',()=>{ stepUpField?.classList.toggle('hidden',!stepUpToggle.checked); scheduleRender(); });
  form.addEventListener('submit',(event)=>event.preventDefault());
  render();
}
</script>

<script>
  (function () {
    'use strict';
    var btn = document.getElementById('financesikh-footer-cookie-settings');
    if (btn) {
      var attemptOpen = function (attempts: number) {
        if (window.financesikhCookie && typeof window.financesikhCookie.openSettings === 'function') {
          window.financesikhCookie.openSettings(btn);
        } else if (attempts > 0) {
          setTimeout(function () { attemptOpen(attempts - 1); }, 50);
        }
      };
      btn.addEventListener('click', function () {
        attemptOpen(20);
      });
    }
  })();
</script>
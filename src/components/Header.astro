<header class="sticky top-0 z-50 border-b border-[var(--color-line)] bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80">
  <div class="wrap flex min-h-16 items-center justify-between gap-4">
    <a class="flex items-center gap-2 font-bold text-ink no-underline" href="/">
      <img src="/finance-sikh-mark.svg" width="32" height="32" alt="Finance Sikh logo" />
      <span>Finance Sikh</span>
    </a>
    
    <!-- Desktop Navigation -->
    <nav aria-label="Main navigation" class="hidden md:block">
      <ul class="flex flex-wrap items-center gap-4 text-sm font-semibold">
        <li><a class="text-[var(--color-ink)] hover:text-[#066b75]" href="/">Home</a></li>
        <li><a class="text-[var(--color-ink)] hover:text-[#066b75]" href="/blog/">Blog</a></li>
        <li class="group relative">
          <button class="inline-flex items-center gap-1 text-[var(--color-ink)] hover:text-[#066b75]" aria-haspopup="true">
            <span>Calculators</span>
            <svg class="size-3" viewBox="0 0 12 12" aria-hidden="true"><path fill="currentColor" d="M2.2 4.2 6 8l3.8-3.8-.9-.9L6 6.2 3.1 3.3z" /></svg>
          </button>
          <div class="absolute left-0 top-full z-40 hidden min-w-52 pt-2 group-hover:block group-focus-within:block">
            <ul class="rounded-xl border border-[var(--color-line)] bg-white py-1 shadow-lg" aria-label="Calculator pages">
              <li><a class="block px-4 py-2 no-underline hover:bg-[var(--color-mist)]" href="/calculators/sip-calculator/">SIP calculator</a></li>
              <li><a class="block px-4 py-2 no-underline hover:bg-[var(--color-mist)]" href="/calculators/swp-calculator/">SWP calculator</a></li>
            </ul>
          </div>
        </li>
        <li><a class="text-[var(--color-ink)] hover:text-[#066b75]" href="/about/">About</a></li>
        <li><a class="text-[var(--color-ink)] hover:text-[#066b75]" href="/contact/">Contact</a></li>
      </ul>
    </nav>

    <!-- Mobile Menu Button -->
    <button 
      id="mobile-menu-button"
      class="md:hidden inline-flex items-center justify-center rounded-lg p-2 hover:bg-[var(--color-mist)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#e49b36]"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Navigation -->
  <nav id="mobile-menu" class="md:hidden hidden border-t border-[var(--color-line)] bg-white">
      <ul class="wrap flex flex-col py-2">
        <li><a class="block py-2 px-2 text-[var(--color-ink)] hover:text-[#066b75]" href="/">Home</a></li>
        <li><a class="block py-2 px-2 text-[var(--color-ink)] hover:text-[#066b75]" href="/blog/">Blog</a></li>
        <li>
          <button 
            id="mobile-calculators-button"
            class="flex w-full items-center justify-between py-2 px-2 text-[var(--color-ink)] hover:text-[#066b75]"
            aria-expanded="false"
          >
            <span>Calculators</span>
            <svg class="size-3" viewBox="0 0 12 12" aria-hidden="true"><path fill="currentColor" d="M2.2 4.2 6 8l3.8-3.8-.9-.9L6 6.2 3.1 3.3z" /></svg>
          </button>
          <ul id="mobile-calculators-menu" class="hidden ml-4">
            <li><a class="block py-2 px-2 text-[var(--color-ink)] hover:text-[#066b75]" href="/calculators/sip-calculator/">SIP calculator</a></li>
            <li><a class="block py-2 px-2 text-[var(--color-ink)] hover:text-[#066b75]" href="/calculators/swp-calculator/">SWP calculator</a></li>
          </ul>
      </li>
        <li><a class="block py-2 px-2 text-[var(--color-ink)] hover:text-[#066b75]" href="/about/">About</a></li>
        <li><a class="block py-2 px-2 text-[var(--color-ink)] hover:text-[#066b75]" href="/contact/">Contact</a></li>
    </ul>
  </nav>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileCalculatorsButton = document.getElementById('mobile-calculators-button');
  const mobileCalculatorsMenu = document.getElementById('mobile-calculators-menu');

  if (mobileMenuButton && mobileMenu) {
    mobileMenuButton.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.contains('hidden');
      if (isOpen) {
        mobileMenu.classList.remove('hidden');
        mobileMenuButton.setAttribute('aria-expanded', 'true');
      } else {
        mobileMenu.classList.add('hidden');
        mobileMenuButton.setAttribute('aria-expanded', 'false');
      }
    });
  }

  if (mobileCalculatorsButton && mobileCalculatorsMenu) {
    mobileCalculatorsButton.addEventListener('click', () => {
      const isOpen = mobileCalculatorsMenu.classList.contains('hidden');
      if (isOpen) {
        mobileCalculatorsMenu.classList.remove('hidden');
        mobileCalculatorsButton.setAttribute('aria-expanded', 'true');
      } else {
        mobileCalculatorsMenu.classList.add('hidden');
        mobileCalculatorsButton.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>

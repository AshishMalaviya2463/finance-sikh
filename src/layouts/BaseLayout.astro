---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
const { title, description, lang = 'en-IN', alternates, locale = 'en_IN', type = 'website', publishedTime, modifiedTime, author } = Astro.props;
---
<!doctype html><html lang={lang}><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><SEOHead {title} {description} alternates={alternates} locale={locale} type={type} publishedTime={publishedTime} modifiedTime={modifiedTime} author={author} />
<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-RZFYY1898B"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    window.dataLayer.push(arguments);
  }
  gtag('js', new Date());
  gtag('config', 'G-RZFYY1898B');
</script>
</head><body><a class="sr-only focus:not-sr-only" href="#content">Skip to content</a><Header /><main id="content"><slot /></main><Footer /></body></html>

---
import '../styles/global.css'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import SEOHead from '../components/SEOHead.astro';
const { title, description } = Astro.props;
---
<!doctype html><html lang="en-IN"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><SEOHead {title} {description} />
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-RZFYY1898B"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-RZFYY1898B');
</script>
</head><body><a class="sr-only focus:not-sr-only" href="#content">Skip to content</a><Header /><main id="content"><slot /></main><Footer /></body></html>

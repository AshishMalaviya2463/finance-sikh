---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).filter(p => (p.data.language || 'en') === 'en').sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Personal Finance Blog" description="A flat collection of practical Indian personal-finance explainers." lang="en">
  <nav class="wrap pt-6" aria-label="Choose article language">
    <div class="inline-flex rounded-lg border border-[var(--color-line)] bg-white p-1">
      <a href="/hi/blog/" class="rounded-md px-3 py-1.5 text-sm font-semibold text-[var(--color-ink)] no-underline hover:bg-[var(--color-mist)]">हिन्दी</a>
      <a href="/en/blog/" aria-current="page" class="rounded-md bg-teal px-3 py-1.5 text-sm font-semibold text-white no-underline">English</a>
    </div>
  </nav>
  <section class="wrap py-12">
    <h1 class="text-4xl font-bold">Blog</h1>
    <p class="mt-3 max-w-2xl">A single, browsable collection of plain-language money explainers.</p>
    <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {posts.map(post => (
        <article class="card flex h-full flex-col">
          <p class="text-sm text-slate-600">Published {post.data.pubDate.toLocaleDateString('en-IN')}</p>
          <h2 class="mt-2 text-2xl font-bold"><a href={`/en/blog/${post.data.translationKey || post.id.replace(/\.md$/, '')}/`}>{post.data.title}</a></h2>
          <p class="mt-3">{post.data.description}</p>
          <a class="mt-auto pt-5 font-semibold" href={`/en/blog/${post.data.translationKey || post.id.replace(/\.md$/, '')}/`}>Read article &rarr;</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

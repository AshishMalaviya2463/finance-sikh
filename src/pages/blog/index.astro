---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts=(await getCollection('blog')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="Personal Finance Blog" description="A flat collection of practical Indian personal-finance explainers."><section class="wrap py-12"><h1 class="text-4xl font-bold">Blog</h1><p class="mt-3 max-w-2xl">A single, browsable collection of plain-language money explainers.</p><div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">{posts.map(post => <article class="card flex h-full flex-col"><p class="text-sm text-slate-600">Published {post.data.pubDate.toLocaleDateString('en-IN')}</p><h2 class="mt-2 text-2xl font-bold"><a href={`/blog/${post.id.replace(/\.md$/, '')}/`}>{post.data.title}</a></h2><p class="mt-3">{post.data.description}</p><a class="mt-auto pt-5 font-semibold" href={`/blog/${post.id.replace(/\.md$/, '')}/`}>Read article &rarr;</a></article>)}</div></section></BaseLayout>
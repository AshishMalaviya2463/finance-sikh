---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { getCollection } from 'astro:content'; const posts=(await getCollection('blog')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="Blog" description="A flat collection of practical Indian personal-finance explainers."><section class="wrap py-12"><h1 class="text-4xl font-bold">Blog</h1><p class="mt-3 max-w-2xl">A single, browsable collection of plain-language money explainers.</p><div class="mt-8 grid gap-4">{posts.map(post => <article class="card"><p class="text-sm text-slate-600">Published {post.data.pubDate.toLocaleDateString('en-IN')}</p><h2 class="mt-1 text-2xl font-bold"><a href={`/blog/${post.id.replace(/\.md$/, '')}/`}>{post.data.title}</a></h2><p>{post.data.description}</p><a href={`/blog/${post.id.replace(/\.md$/, '')}/`}>Read article →</a></article>)}</div></section></BaseLayout>

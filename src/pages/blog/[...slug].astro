---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter(post => (post.data.language || 'en') === 'en')
    .map(post => ({
      params: { slug: post.id.replace(/\.md$/, '') }
    }));
}
---
<!doctype html><html lang="en-IN"><head><meta charset="utf-8" /><meta http-equiv="refresh" content={`0; url=/en/blog/${Astro.params.slug}/`} /><title>Redirecting...</title></head><body><a href={`/en/blog/${Astro.params.slug}/`}>Continue</a><script>{`window.location.replace('/en/blog/${Astro.params.slug}/');`}</script></body></html>
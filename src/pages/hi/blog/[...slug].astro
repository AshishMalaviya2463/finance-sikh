---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const paths = [];
  for (const post of posts.filter(p => p.data.language === 'hi')) {
    const canonical = post.data.translationKey || post.id.replace(/\.md$/, '').replace(/-hi$/, '');
    const original = post.id.replace(/\.md$/, '');
    paths.push({ params: { slug: canonical }, props: { post, redirect: false } });
    if (original !== canonical) {
      paths.push({ params: { slug: original }, props: { post, redirect: true, target: canonical } });
    }
  }
  return paths;
}

const { post, redirect, target } = Astro.props;
if (redirect) {
  return Astro.redirect(`/hi/blog/${target}/`, 301);
}
const { Content } = await render(post);
const allPosts = await getCollection('blog');
const counterpart = allPosts.find(p => p.data.translationKey && p.data.translationKey === post.data.translationKey && p.data.language === 'en');
const hiUrl = `/hi/blog/${post.data.translationKey || post.id.replace(/\.md$/, '').replace(/-hi$/, '')}/`;
const enUrl = counterpart ? `/en/blog/${counterpart.data.translationKey || counterpart.id.replace(/\.md$/, '')}/` : null;
const alternates = [{ hreflang: 'hi', href: new URL(hiUrl, Astro.site).toString() }];
if (enUrl) alternates.push({ hreflang: 'en', href: new URL(enUrl, Astro.site).toString() });
if (enUrl) alternates.push({ hreflang: 'x-default', href: new URL(hiUrl, Astro.site).toString() });
---
<BaseLayout title={post.data.title} description={post.data.description} lang="hi" alternates={alternates} locale="hi_IN" type="article" publishedTime={post.data.pubDate.toISOString()} modifiedTime={post.data.updatedDate?.toISOString()} author={post.data.authorName}>
  <nav class="wrap pt-6" aria-label="Choose article language">
    <div class="inline-flex rounded-lg border border-[var(--color-line)] bg-white p-1">
      <a href={hiUrl} aria-current="page" class="rounded-md bg-teal px-3 py-1.5 text-sm font-semibold text-white no-underline">हिन्दी</a>
      {enUrl ? (
        <a href={enUrl} class="rounded-md px-3 py-1.5 text-sm font-semibold text-[var(--color-ink)] no-underline hover:bg-[var(--color-mist)]">English</a>
      ) : (
        <span class="rounded-md px-3 py-1.5 text-sm font-semibold text-slate-400" aria-disabled="true">English</span>
      )}
    </div>
  </nav>
  <article class="wrap prose py-12">
    <p class="text-sm text-slate-600">By {post.data.authorName} &middot; First published {post.data.pubDate.toLocaleDateString('hi-IN')}{post.data.updatedDate && ` &middot; Updated ${post.data.updatedDate.toLocaleDateString('hi-IN')}`}</p>
    <h1 class="text-4xl font-bold">{post.data.title}</h1>
    <p class="text-xl">{post.data.description}</p>
    <Content />
    <section>
      <h2>Sources</h2>
      <ul>
        {post.data.sources.map(source => <li><a href={source.url} rel="nofollow noopener" target="_blank">{source.name}</a></li>)}
      </ul>
    </section>
    <p class="rounded-lg bg-slate-100 p-4 text-sm">Educational information only. Verify current rules and consider qualified advice for personal decisions.</p>
  </article>
</BaseLayout>
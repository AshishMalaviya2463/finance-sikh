---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="Indian personal-finance education for everyday households" description="Plain-language Indian personal-finance education, calculators, and guides for budgeting, saving, investing, insurance, and taxes.">
  <section class="wrap py-16">
    <p class="font-semibold text-teal">Independent financial education</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-bold md:text-6xl">Indian personal-finance education for everyday households</h1>
    <p class="mt-6 max-w-2xl text-lg leading-8">Finance Sikh helps first-time investors, salaried employees and families understand everyday money topics, products, calculations and trade-offs &mdash; without personalised recommendations.</p>
    <div class="mt-7 flex gap-3">
      <a class="button" href="/blog/">Read the blog</a>
      <a class="button bg-ink" href="/calculators/">Try calculators</a>
    </div>
  </section>
  <section class="wrap grid gap-6 pb-12 md:grid-cols-2">
    <article class="card">
      <h2 class="text-2xl font-bold">Plan with assumptions</h2>
      <p>Use transparent SIP and SWP illustrations before making decisions.</p>
      <a href="/calculators/">Explore calculators &rarr;</a>
    </article>
    <article class="card">
      <h2 class="text-2xl font-bold">Education, not advice</h2>
      <p>Rules and returns can change. Check primary sources and seek qualified help for personal decisions.</p>
      <a href="/disclaimer/">Read our disclaimer &rarr;</a>
    </article>
  </section>
  <section class="wrap py-10">
    <h2 class="text-3xl font-bold">Latest articles</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {posts.slice(0,6).map(post => <article class="card"><h3 class="font-bold"><a href={`/blog/${post.id.replace(/\.md$/, '')}/`}>{post.data.title}</a></h3><p class="text-sm text-slate-600">{post.data.description}</p></article>)}
    </div>
  </section>
</BaseLayout>
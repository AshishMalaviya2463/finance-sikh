              <td class="border border-[var(--color-line)] px-4 py-2.5 font-medium">Cash Flow</td>
              <td class="border border-[var(--color-line)] px-4 py-2.5">Money going in</td>
              <td class="border border-[var(--color-line)] px-4 py-2.5">Money coming out</td>
            </tr>
            <tr class="bg-white">
              <td class="border border-[var(--color-line)] px-4 py-2.5 font-medium">Start</td>
